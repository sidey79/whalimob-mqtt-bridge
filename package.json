{
  "name": "whalibmob-mqtt-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node.js TypeScript bridge between whalibmob and MQTT.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "mqtt": "^5.10.4",
    "pino": "^9.6.0"
  },
  "peerDependencies": {
    "whalibmob": "*"
  },
  "peerDependenciesMeta": {
    "whalibmob": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
